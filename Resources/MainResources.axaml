<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand Colors -->
    <SolidColorBrush x:Key="AccentRed" Color="#DC143C" />
    <SolidColorBrush x:Key="AccentRedHover" Color="#F0244F" />
    <SolidColorBrush x:Key="AccentRedDark" Color="#A10E2C" />
    <SolidColorBrush x:Key="AccentRedSoft" Color="#2EDC143C" />
    <SolidColorBrush x:Key="Green" Color="#3DD68C" />
    <SolidColorBrush x:Key="Gold" Color="#FFC940" />
    <Color x:Key="RedColor">#DC143C</Color>
    <Color x:Key="DarkerRedColor">#A10E2C</Color>

    <!-- Surface Colors (darkest -> lightest) -->
    <SolidColorBrush x:Key="BackgroundBlack" Color="#0C0C0E" />
    <SolidColorBrush x:Key="BackgroundGray" Color="#131316" />
    <SolidColorBrush x:Key="Background0" Color="#18181C" />
    <SolidColorBrush x:Key="Surface2" Color="#212126" />
    <SolidColorBrush x:Key="Background1" Color="#26262C" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#2C2C34" />
    <SolidColorBrush x:Key="Surface3" Color="#34343D" />

    <!-- Border Colors -->
    <SolidColorBrush x:Key="Border" Color="#202026" />
    <SolidColorBrush x:Key="BorderLight" Color="#2A2A31" />
    <SolidColorBrush x:Key="BorderHover" Color="#4A4A56" />

    <!-- Text Colors -->
    <SolidColorBrush x:Key="White" Color="#F2F2F4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9B9BA6" />
    <SolidColorBrush x:Key="TextMuted" Color="#6C6C78" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusWatching" Color="#4CAF50" />
    <SolidColorBrush x:Key="StatusCompleted" Color="#2196F3" />
    <SolidColorBrush x:Key="StatusOnHold" Color="#FF9800" />
    <SolidColorBrush x:Key="StatusDropped" Color="#F44336" />
    <SolidColorBrush x:Key="StatusPlanToWatch" Color="#9C27B0" />

    <Color x:Key="StatusWatchingColor">#4CAF50</Color>
    <Color x:Key="StatusCompletedColor">#2196F3</Color>
    <Color x:Key="StatusOnHoldColor">#FF9800</Color>
    <Color x:Key="StatusDroppedColor">#F44336</Color>
    <Color x:Key="StatusPlanToWatchColor">#9C27B0</Color>

    <!-- ===== Fluent theme overrides: retune every built-in control once ===== -->
    <Color x:Key="SystemAccentColor">#DC143C</Color>
    <Color x:Key="SystemAccentColorDark1">#C21235</Color>
    <Color x:Key="SystemAccentColorDark2">#A10E2C</Color>
    <Color x:Key="SystemAccentColorDark3">#800B23</Color>
    <Color x:Key="SystemAccentColorLight1">#E63D5E</Color>
    <Color x:Key="SystemAccentColorLight2">#EE6680</Color>
    <Color x:Key="SystemAccentColorLight3">#F58FA3</Color>

    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <Thickness x:Key="ButtonPadding">14,8</Thickness>

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#212126" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#34343D" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2C2C34" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#18181C" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#F2F2F4" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F2F2F4" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2F2F4" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6C6C78" />

    <!-- ToggleButton (checked state follows SystemAccentColor) -->
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#212126" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#34343D" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#2C2C34" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />

    <!-- TextBox -->
    <Thickness x:Key="TextControlThemePadding">12,7,8,7</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <SolidColorBrush x:Key="TextControlBackground" Color="#212126" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#212126" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#212126" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A4A56" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#DC143C" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#F2F2F4" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F2F4" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F2F2F4" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6C6C78" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6C6C78" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6C6C78" />

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#212126" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#34343D" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2C2C34" />
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#212126" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4A4A56" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#DC143C" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#F2F2F4" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#9B9BA6" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#18181C" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#34343D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2EDC143C" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#44DC143C" />

    <!-- Flyouts, menus, tooltips -->
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#18181C" />
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#18181C" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#34343D" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2C2C34" />
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">6</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePadding">12,8</Thickness>
    <SolidColorBrush x:Key="ToolTipBackground" Color="#18181C" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#F2F2F4" />

    <!-- ScrollBar: thin overlay, subtle thumb -->
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#4A4A56" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#4A4A56" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#6C6C78" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#9B9BA6" />
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#18181C" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#9B9BA6" />

    <!-- Tabs -->
    <x:Double x:Key="TabItemHeaderFontSize">18</x:Double>
    <FontWeight x:Key="TabItemHeaderThemeFontWeight">SemiBold</FontWeight>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#DC143C" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#9B9BA6" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#F2F2F4" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#F2F2F4" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#F2F2F4" />
</ResourceDictionary>
