<UserControl
    x:Class="Aniki.Views.OnlineView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Aniki.ViewModels;assembly=Aniki"
    xmlns:models="clr-namespace:Aniki.Models"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:anime="clr-namespace:Aniki.Services.Anime"
    x:DataType="vm:OnlineViewModel">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource Background0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- Results list -->
        <Style Selector="ListBox.results">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentRedSoft}"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#44DC143C"/>
        </Style>

        <!-- Episode chips -->
        <Style Selector="ListBox.episodes">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBox.episodes ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.episodes ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.episodes ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
        </Style>
        <Style Selector="ListBox.episodes ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
        </Style>
        <Style Selector="ListBox.episodes ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentRedHover}"/>
        </Style>
        <Style Selector="ListBox.episodes ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style Selector="ComboBox.filled">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.play-fab">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="CornerRadius" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.play-fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)"/>
        </Style>
        <Style Selector="Button.play-fab:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*" ColumnSpacing="16">

        <!-- LEFT: Search + Results -->
        <Border Grid.Column="0" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*">

                <TextBox Grid.Row="0"
                         x:Name="SearchTextBox"
                         Classes="search-box"
                         Margin="12,12,12,8"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         Watermark="Search anime…"
                         KeyDown="OnSearchKeyDown">
                    <TextBox.InnerLeftContent>
                        <Button Classes="search-icon-btn"
                                Command="{Binding SearchAnimeCommand}"
                                ToolTip.Tip="Search">
                            <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Width="15" Height="15"
                                      Foreground="{StaticResource TextSecondary}"/>
                        </Button>
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsLoading}"
                                     Width="50" Height="3"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     Foreground="{StaticResource AccentRed}"/>
                    </TextBox.InnerRightContent>
                </TextBox>

                <Grid Grid.Row="1" Margin="16,6,16,6" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="section-label" Text="RESULTS" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="{StaticResource Surface2}"
                            CornerRadius="10"
                            Padding="8,2"
                            IsVisible="{Binding AnimeResults.Count}">
                        <TextBlock Text="{Binding AnimeResults.Count}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox Classes="results"
                             ItemsSource="{Binding AnimeResults}"
                             SelectedItem="{Binding SelectedAnime}"
                             IsVisible="{Binding AnimeResults.Count}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:AniDbSearchResult">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Width="42" Height="58" CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface3}">
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding Banner}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource White}"/>
                                        <TextBlock Text="{Binding Episodes, StringFormat='{}{0} episodes'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Margin="20"
                                IsVisible="{Binding !AnimeResults.Count}">
                        <Border Width="48" Height="48"
                                CornerRadius="24"
                                Background="{StaticResource Surface2}"
                                HorizontalAlignment="Center">
                            <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Width="22" Height="22"
                                      Foreground="{StaticResource TextMuted}"/>
                        </Border>
                        <TextBlock Text="No results yet"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT: header, player stage, episode dock -->
        <Border Grid.Column="1" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" Height="150" IsVisible="{Binding SelectedAnime, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Image asyncImageLoader:ImageLoader.Source="{Binding AnimeImageUrl}" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="30"/>
                        </Image.Effect>
                    </Image>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                <GradientStop Color="#6618181C" Offset="0"/>
                                <GradientStop Color="#F218181C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="24,14,24,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Bottom">
                        <Border Grid.Column="0" Width="72" Height="100" CornerRadius="10" ClipToBounds="True"
                                BoxShadow="0 8 24 #99000000" Background="{StaticResource Surface3}">
                            <Image asyncImageLoader:ImageLoader.Source="{Binding AnimeImageUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Classes="section-label" Text="NOW WATCHING"/>
                            <TextBlock Text="{Binding SelectedAnime.Title}"
                                       FontWeight="Bold"
                                       FontSize="22"
                                       Foreground="{StaticResource White}"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#2EFFFFFF" CornerRadius="8" Padding="10,4">
                                    <TextBlock Text="{Binding SelectedAnime.Episodes, StringFormat='{}{0} episodes'}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource White}"/>
                                </Border>
                                <Border Background="#2E4CAF50"
                                        CornerRadius="8"
                                        Padding="10,4"
                                        IsVisible="{Binding Source={x:Static anime:AnimeService.IsLoggedIn}}">
                                    <TextBlock Text="{Binding WatchedEpisodesText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource StatusWatching}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Padding="14,8"
                                Background="#2EFFFFFF"
                                ToolTip.Tip="Open anime details"
                                Command="{Binding GoToAnimeDetailsCommand}"
                                IsEnabled="{Binding SelectedAnime.MalId, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{SvgImage /Resources/Icons/info_icon.svg}" Width="15" Height="15"/>
                                <TextBlock Text="Details" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Player stage -->
                <Grid Grid.Row="1" IsVisible="{Binding Episodes.Count}" Background="{StaticResource BackgroundBlack}">
                    <Image asyncImageLoader:ImageLoader.Source="{Binding AnimeImageUrl}" Stretch="UniformToFill" Opacity="0.35">
                        <Image.Effect>
                            <BlurEffect Radius="50"/>
                        </Image.Effect>
                    </Image>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                <GradientStop Color="#990C0C0E" Offset="0"/>
                                <GradientStop Color="#330C0C0E" Offset="0.5"/>
                                <GradientStop Color="#CC0C0C0E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Episode chosen -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="18"
                                IsVisible="{Binding SelectedEpisode, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button Classes="primary play-fab"
                                HorizontalAlignment="Center"
                                Command="{Binding PlayInBrowserCommand}"
                                IsEnabled="{Binding CanPlayVideo}"
                                ToolTip.Tip="Play">
                            <PathIcon Data="M8 5v14l11-7z" Width="36" Height="36" Foreground="White" Margin="6,0,0,0"/>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedEpisode.Number, StringFormat='Episode {0}'}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedPlayer.DisplayName, StringFormat='Ready to play in {0}'}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding CanPlayVideo}"/>
                            <TextBlock Text="Resolving stream…"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding IsLoading}"/>
                            <TextBlock Text="The stream server may be having issues, so this episode might not play."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="380"
                                       IsVisible="{Binding ShowStreamProviderNote}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ComboBox Classes="filled"
                                      ItemsSource="{Binding AvailablePlayers}"
                                      SelectedItem="{Binding SelectedPlayer}"
                                      MinWidth="170"
                                      ToolTip.Tip="Video player">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="primary"
                                    Padding="22,0"
                                    Height="38"
                                    Command="{Binding PlayInBrowserCommand}"
                                    IsEnabled="{Binding CanPlayVideo}">
                                <TextBlock Text="Play episode" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- No episode yet -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding SelectedEpisode, Converter={x:Static ObjectConverters.IsNull}}">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#2EFFFFFF" HorizontalAlignment="Center">
                            <PathIcon Data="M8 5v14l11-7z" Width="26" Height="26" Foreground="White" Margin="4,0,0,0"/>
                        </Border>
                        <TextBlock Text="Pick an episode below"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="The stream is resolved as soon as you choose one."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <Grid Grid.Row="1" IsVisible="{Binding !Episodes.Count}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16"
                                Margin="24">
                        <Image Source="/Resources/nothingtoseehere_transparent_small.png"
                               Width="240"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="{Binding SelectionStatusMessage}"
                                   IsVisible="{Binding ShowSelectionStatus}"
                                   Foreground="{StaticResource White}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Search for a title on the left, pick a result, then choose an episode."
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   IsVisible="{Binding !ShowStreamProviderNote}"/>
                        <TextBlock Text="The stream server may be having issues, so episodes might not load or play. Developers are working on it."
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   IsVisible="{Binding ShowStreamProviderNote}"/>
                    </StackPanel>
                </Grid>

                <!-- Episode dock -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Border}"
                        Background="{StaticResource BackgroundGray}"
                        Padding="20,12,20,8"
                        IsVisible="{Binding Episodes.Count}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Classes="section-label" Text="EPISODES" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      Height="30"
                                      MinWidth="160"
                                      Padding="10,0"
                                      FontSize="12"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding EpisodeRanges}"
                                      SelectedItem="{Binding SelectedRange}"
                                      IsVisible="{Binding HasMultipleRanges}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:EpisodeRange">
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Episodes.Count, StringFormat='{}{0} episodes available'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox Classes="episodes"
                                 ItemsSource="{Binding VisibleEpisodes}"
                                 SelectedItem="{Binding SelectedEpisode}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:AniDbEpisode">
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
