<Window
    x:Class="Aniki.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Aniki.Views;assembly=Aniki"
    xmlns:vm="clr-namespace:Aniki.ViewModels;assembly=Aniki"
    xmlns:anime="clr-namespace:Aniki.Services.Anime"
    xmlns:misc="clr-namespace:Aniki.Misc"
    Title="Aniki - Anime Client"
    d:DesignHeight="720"
    d:DesignWidth="1080"
    x:DataType="vm:MainViewModel"
    Background="{StaticResource BackgroundBlack}"
    ExtendClientAreaTitleBarHeightHint="30"
    ExtendClientAreaToDecorationsHint="True"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Sidebar navigation item -->
        <Style Selector="Button.MenuButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,9,12,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.MenuButton /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.MenuButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
        </Style>
        <Style Selector="Button.MenuButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.MenuButton TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.MenuButton Image">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.MenuButton Border.indicator">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="0,2,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.MenuButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource White}" />
        </Style>
        <Style Selector="Button.MenuButton:pointerover Image">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.MenuButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
        </Style>
        <Style Selector="Button.MenuButton.selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource White}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.MenuButton.selected Image">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.MenuButton.selected Border.indicator">
            <Setter Property="Background" Value="{StaticResource AccentRed}" />
        </Style>
        <Style Selector="Button.ModeButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ModeButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.nav-section">
            <Setter Property="Margin" Value="12,18,0,6" />
        </Style>

        <!-- Back / forward arrows -->
        <Style Selector="Button.NavArrow">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.NavArrow /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.NavArrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.NavArrow PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavArrow:pointerover PathIcon">
            <Setter Property="Foreground" Value="{StaticResource White}" />
        </Style>
        <Style Selector="Button.NavArrow:disabled PathIcon">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Not-logged-in placeholder -->
        <Style Selector="StackPanel.empty-state > TextBlock.title">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource White}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.empty-state > TextBlock.subtitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="30"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    IsHitTestVisible="True"
                    ZIndex="100"
                    PointerPressed="OnBeginDrag"/>

            <!-- Sidebar -->
            <Grid x:Name="Sidebar" Grid.Column="0" Margin="12,38,8,16" RowDefinitions="Auto,*,Auto">

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="12,0,0,10">
                    <Image Source="avares://Aniki/Resources/icon.ico" Width="26" Height="26" VerticalAlignment="Center"/>
                    <TextBlock Text="Aniki"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource White}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="2">
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="3" Margin="8,4,4,6">
                        <Grid ColumnDefinitions="*,*">
                            <Button Classes="ModeButton" Content="Anime"
                                    Classes.selected="{Binding IsAnime, Source={x:Static misc:MediaMode.Instance}}"
                                    Command="{Binding SetMediaKindCommand}" CommandParameter="Anime"/>
                            <Button Grid.Column="1" Classes="ModeButton" Content="Manga"
                                    Classes.selected="{Binding IsManga, Source={x:Static misc:MediaMode.Instance}}"
                                    Command="{Binding SetMediaKindCommand}" CommandParameter="Manga"/>
                        </Grid>
                    </Border>
                    <TextBlock Classes="section-label nav-section" Text="MENU" />
                    <Button Name="MainPageButton"
                            Classes="MenuButton"
                            Classes.selected="{Binding IsMainPageNavSelected}"
                            Command="{Binding ShowAnimeBrowsePageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/home_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Main Page" />
                        </Grid>
                    </Button>
                    <Button Name="AnimeDetailsButton"
                            Classes="MenuButton"
                            Classes.selected="{Binding IsAnimeDetailsNavSelected}"
                            Command="{Binding ShowAnimeDetailsPageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/info_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="{Binding Noun, Source={x:Static misc:MediaMode.Instance}, StringFormat='{}{0} Details'}" />
                        </Grid>
                    </Button>
                    <Button Name="WatchPageButton"
                            Classes="MenuButton"
                            Classes.selected="{Binding IsWatchNavSelected}"
                            IsVisible="{Binding IsAnime, Source={x:Static misc:MediaMode.Instance}}"
                            Command="{Binding ShowWatchPageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*,Auto">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/play_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Watch" />
                            <Border Grid.Column="5"
                                    Background="{StaticResource RedColor}"
                                    CornerRadius="9"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="5,0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding WatchViewModel.DownloadedViewModel.NewEpisodesCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                    ToolTip.Tip="New episodes you haven't watched or downloaded">
                                <TextBlock Text="{Binding WatchViewModel.DownloadedViewModel.NewEpisodesCount}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Name="CalendarPageButton"
                            Classes="MenuButton"
                            Classes.selected="{Binding IsCalendarNavSelected}"
                            IsVisible="{Binding IsAnime, Source={x:Static misc:MediaMode.Instance}}"
                            Command="{Binding ShowCalendarPageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/calendar_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Calendar" />
                        </Grid>
                    </Button>
                    <Button Name="ExplorePageButton"
                            Classes="MenuButton"
                            Command="{Binding ShowExplorePageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/search_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Explore" />
                        </Grid>
                    </Button>
                    <Button Name="ReadPageButton"
                            Classes="MenuButton"
                            IsVisible="{Binding IsManga, Source={x:Static misc:MediaMode.Instance}}"
                            Command="{Binding ShowReadPageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/book_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Read" />
                        </Grid>
                    </Button>

                    <TextBlock Classes="section-label nav-section" Text="USER" />
                    <Button Name="StatsPageButton"
                            Classes="MenuButton"
                            Classes.selected="{Binding IsStatsNavSelected}"
                            Command="{Binding ShowStatsPageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/person_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Profile" />
                        </Grid>
                    </Button>
                    <Button Name="YourLibraryButton"
                            Classes="MenuButton"
                            Classes.selected="{Binding IsLibraryNavSelected}"
                            Command="{Binding ShowUserAnimeListPageCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/book_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Your Library" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Border Height="1" Background="{StaticResource Border}" Margin="12,0,4,10" />
                    <Button Name="SettingsPageButton"
                            Classes="MenuButton"
                            Command="{Binding OpenSettingsCommand}">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/settings_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Settings" />
                        </Grid>
                    </Button>
                    <Button Name="LogOutButton"
                            Classes="MenuButton"
                            Click="LogOut">
                        <Grid ColumnDefinitions="3,10,Auto,10,*">
                            <Border Classes="indicator" />
                            <Image Grid.Column="2" Source="{SvgImage /Resources/Icons/logout_icon.svg}" />
                            <TextBlock Grid.Column="4" Text="Log Out" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Content  -->
            <Border
                x:Name="ContentHost"
                Grid.Column="1"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1,0,0,0"
                ClipToBounds="True"
                Background="{StaticResource BackgroundBlack}">
                <Grid x:Name="Root">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Loading indicator  -->
                    <Grid Grid.Row="0" IsVisible="{Binding IsLoading}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar
                                Width="260"
                                Height="4"
                                Background="{StaticResource Surface2}"
                                Foreground="{StaticResource AccentRed}"
                                IsIndeterminate="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondary}"
                                Text="Loading…" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="0" IsVisible="{Binding !IsLoading}">
                        <Panel>
                        <UserControl Background="{StaticResource BackgroundBlack}">
                            <UserControl.DataTemplates>
                                <DataTemplate DataType="vm:AnimeDetailsViewModel">
                                    <views:AnimeDetailsView DataContext="{Binding}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:WatchAnimeViewModel">
                                    <views:WatchAnimeView DataContext="{Binding}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:CalendarViewModel">
                                    <views:CalendarView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:ExploreViewModel">
                                    <views:ExploreView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:ReadViewModel">
                                    <views:ReadView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AnimeBrowseViewModel">
                                    <views:AnimeBrowseView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:UserAnimeListViewModel">
                                    <Panel>
                                        <views:UserAnimeListView IsVisible="{x:Static anime:AnimeService.IsLoggedIn}"/>
                                        <Grid IsVisible="{Binding Source={x:Static anime:AnimeService.IsLoggedIn},
                                            Converter={x:Static BoolConverters.Not}}"
                                              ClipToBounds="True">
                                            <StackPanel Classes="empty-state" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                                                <Image Source="/Resources/nothingtoseehere_transparent_small.png"
                                                       Width="260"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <TextBlock Classes="title" Text="You are not logged in"/>
                                                <TextBlock Classes="subtitle" Text="Log in to view your list."/>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:StatsViewModel">
                                    <Panel>
                                        <views:StatsView IsVisible="{x:Static anime:AnimeService.IsLoggedIn}"/>
                                        <Grid IsVisible="{Binding Source={x:Static anime:AnimeService.IsLoggedIn},
                                            Converter={x:Static BoolConverters.Not}}"
                                              ClipToBounds="True">
                                            <StackPanel Classes="empty-state" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                                                <Image Source="/Resources/nothingtoseehere_transparent_small.png"
                                                       Width="260"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <TextBlock Classes="title" Text="You are not logged in"/>
                                                <TextBlock Classes="subtitle" Text="Log in to view your stats."/>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                            </UserControl.DataTemplates>
                            <ContentControl Content="{Binding CurrentViewModel}" />
                        </UserControl>
                        </Panel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel
                x:Name="NavArrows"
                Grid.Column="1"
                Margin="-7,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="-15"
                ZIndex="102"
                IsHitTestVisible="True"
                IsVisible="{Binding !IsLoading}">
                <Button
                    Classes="NavArrow"
                    Command="{Binding NavigateBackCommand}"
                    IsEnabled="{Binding CanNavigateBack}"
                    ToolTip.Tip="Back">
                    <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                </Button>
                <Button
                    Classes="NavArrow"
                    Command="{Binding NavigateForwardCommand}"
                    IsEnabled="{Binding CanNavigateForward}"
                    ToolTip.Tip="Forward">
                    <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
                </Button>
            </StackPanel>
        </Grid>
    </Panel>
</Window>
