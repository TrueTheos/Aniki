<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aniki.ViewModels"
             xmlns:local="clr-namespace:Aniki.Views"
             xmlns:models="clr-namespace:Aniki.Models"
             xmlns:misc="clr-namespace:Aniki.Misc"
             x:Class="Aniki.Views.ExploreView"
             x:DataType="vm:ExploreViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.chip">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="{StaticResource BackgroundBlack}">
        <StackPanel Spacing="24" Margin="50,40,50,40">
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource White}"
                       Text="{Binding Noun, Source={x:Static misc:MediaMode.Instance}, StringFormat='{}Explore {0}'}"/>

            <TextBox Classes="search-box" Text="{Binding SearchText}" Watermark="Search by title…"
                     Width="420" HorizontalAlignment="Left">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Width="15" Height="15" Margin="10,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Background="Transparent" BorderThickness="0" Padding="6,0" VerticalAlignment="Center"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Width="12" Height="12" Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                </TextBox.InnerRightContent>
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>

            <WrapPanel>
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Margin="0,0,10,10"/>
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,10,10"/>
                <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" Margin="0,0,10,10"/>
                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,10"
                        Background="Transparent" Foreground="{StaticResource TextSecondary}" Cursor="Hand"/>
            </WrapPanel>

            <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="GENRES"/>
                <ItemsControl ItemsSource="{Binding Genres}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenreViewModel">
                            <ToggleButton Classes="chip" Content="{Binding Name}" IsChecked="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="TAGS"/>
                <WrapPanel>
                    <AutoCompleteBox ItemsSource="{Binding AllTags}" Text="{Binding TagQuery}" SelectedItem="{Binding PickedTag}"
                                     FilterMode="Contains" MinimumPrefixLength="1" Watermark="Add a tag (e.g. Isekai, Time Skip, Revenge)…"
                                     Width="320" Margin="0,0,12,8"/>
                    <ItemsControl ItemsSource="{Binding SelectedTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Classes="primary" CornerRadius="16" Padding="14,6" Margin="0,0,8,8" FontSize="13"
                                        ToolTip.Tip="Remove tag"
                                        Command="{Binding $parent[ItemsControl].((vm:ExploreViewModel)DataContext).RemoveTagCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding StringFormat='{}{0}  ✕'}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>

            <ProgressBar Height="4" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                         Foreground="{StaticResource AccentRed}" Background="Transparent"/>

            <TextBlock Text="Nothing matches. Try a shorter title, or remove a genre or tag."
                       IsVisible="{Binding HasNoResults}" FontSize="15" Foreground="{StaticResource TextSecondary}"/>

            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AnimeCardData">
                        <local:AnimeCard Margin="0,0,20,24"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="primary" Content="Load more" HorizontalAlignment="Center" Padding="28,12"
                    Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsLoading}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
