<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Aniki.ViewModels"
             xmlns:local="clr-namespace:Aniki.Views"
             xmlns:models="clr-namespace:Aniki.Models"
             xmlns:misc="clr-namespace:Aniki.Misc"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="Aniki.Views.AnimeBrowseView"
             x:DataType="vm:AnimeBrowseViewModel">
    
    <UserControl.Resources>
        <DataTemplate x:Key="SearchBox" x:DataType="vm:AnimeBrowseViewModel">
        <Border
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8"
                Margin="0,4,0,0"
                Cursor="Hand">
            <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0"
                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Width="16" Height="16"
                          Foreground="{StaticResource TextMuted}"
                          Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         Watermark="Type to Search..."
                         Foreground="{StaticResource TextSecondary}"
                         Background="Transparent"
                         BorderThickness="0"
                         MinWidth="200"
                         VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding PerformSearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
            </Grid>
        </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0" Background="{StaticResource BackgroundBlack}" RowDefinitions="*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <ScrollViewer Grid.Column="0" 
                     Grid.Row="0"
                     VerticalScrollBarVisibility="Hidden"
                     HorizontalScrollBarVisibility="Disabled"
                     Background="{StaticResource BackgroundBlack}">
            <StackPanel Spacing="40" Margin="50,30,50,20" Background="{StaticResource BackgroundBlack}">

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchBox}"
                                HorizontalAlignment="Right" Width="420" Margin="0,0,0,-20"
                                IsVisible="{Binding IsManga, Source={x:Static misc:MediaMode.Instance}}"/>
                
                <Border Height="4" Background="Transparent">
                    <ProgressBar Height="4"
                                 Background="Transparent"
                                 Foreground="{StaticResource RedColor}"
                                 IsIndeterminate="{Binding IsLoading}"
                                 IsVisible="{Binding IsLoading}" />
                </Border>


                <StackPanel Spacing="50" IsVisible="{Binding ViewMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Main}">
                    
                    <Border CornerRadius="18"
                            Height="400"
                            Background="{StaticResource BackgroundGray}"
                            ClipToBounds="True"
                            IsVisible="{Binding HeroAnime, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid>
                            <Image asyncImageLoader:ImageLoader.Source="{Binding HeroAnime.Backdrop}"
                                   Stretch="UniformToFill">
                                <Image.Effect>
                                    <BlurEffect Radius="45"/>
                                </Image.Effect>
                            </Image>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="#F20C0C0E" Offset="0"/>
                                        <GradientStop Color="#B30C0C0E" Offset="0.55"/>
                                        <GradientStop Color="#590C0C0E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                        <GradientStop Color="#000C0C0E" Offset="0.45"/>
                                        <GradientStop Color="#CC0C0C0E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" Margin="48,36,48,56">
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            MaxWidth="700"
                                            Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="{StaticResource AccentRed}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeroBadge, Source={x:Static misc:MediaMode.Instance}}" FontSize="10" FontWeight="Bold" Foreground="White" LetterSpacing="1.2"/>
                                        </Border>
                                        <TextBlock Text="{Binding HeroAnime.Meta}"
                                                   Classes="section-label"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding HeroAnime.Title}"
                                               FontSize="42"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               LineHeight="48"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="#2EFFFFFF" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                                                          Width="13" Height="13" Foreground="{StaticResource Gold}"/>
                                                <TextBlock Text="{Binding HeroAnime.Score, StringFormat='{}{0:0.0}'}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#2E4CAF50"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HeroAnime.Status, Converter={StaticResource EnumMatchConverter}, ConverterParameter=watching}">
                                            <TextBlock Text="{Binding Watching, Source={x:Static misc:MediaMode.Instance}}" Foreground="{StaticResource StatusWatching}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding HeroAnime.Genres}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding HeroAnime.Synopsis}"
                                               Foreground="#D9D9DE"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               LineHeight="22"
                                               MaxLines="3"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="620"
                                               HorizontalAlignment="Left"/>

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button Classes="primary" Padding="18,10" Click="OpenHero">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Source="{SvgImage /Resources/Icons/info_icon.svg}" Width="16" Height="16"/>
                                                <TextBlock Text="View details" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="18,10"
                                                Background="#2EFFFFFF"
                                                Command="{Binding PlayHeroVideoCommand}"
                                                IsVisible="{Binding HeroAnime.HasVideo}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Source="{SvgImage /Resources/Icons/play_icon.svg}" Width="16" Height="16"/>
                                                <TextBlock Text="Watch trailer" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="200"
                                        Height="290"
                                        Margin="40,0,0,0"
                                        CornerRadius="12"
                                        ClipToBounds="True"
                                        BoxShadow="0 16 48 #B3000000"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding HeroAnime.PosterUrl}"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="44,0,0,18">
                                <Button Classes="ghost round" Width="30" Height="30" Command="{Binding PreviousHeroCommand}">
                                    <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="16" Height="16"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding HeroAnimeList}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="22" Height="3"
                                                    CornerRadius="2"
                                                    Background="{Binding IsCurrentHero, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#FFFFFF:#55FFFFFF}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="ghost round" Width="30" Height="30" Command="{Binding NextHeroCommand}">
                                    <Image Source="{SvgImage /Resources/Icons/chevronRight_icon.svg}" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="15" IsVisible="{Binding IsManga, Source={x:Static misc:MediaMode.Instance}}">
                        <TextBlock Text="Browse by genre" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <ItemsControl ItemsSource="{Binding GenreChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" CornerRadius="16" Padding="16,7" Margin="0,0,8,8" FontSize="13"
                                            Background="{StaticResource Surface2}" Foreground="{StaticResource White}" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:AnimeBrowseViewModel)DataContext).OpenGenreCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="25" IsVisible="{Binding PopularThisSeason.Count}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="{Binding TopSection, Source={x:Static misc:MediaMode.Instance}}"
                                      FontSize="26"
                                      FontWeight="Bold"
                                      Foreground="White"/>
                        </Grid>
                        
                        <Grid>
                            <Button Classes="ghost round" Background="#00000000"
                                    Click="ScrollLeft"
                                    CommandParameter="{Binding #PopularThisSeasonScroller}"
                                    Foreground="White"
                                    Width="30" Height="30"
                                    CornerRadius="25"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-40,0,0,30"
                                    ZIndex="10"
                                    BorderThickness="0">
                                <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="30" Height="30" />
                            </Button>
                            
                            <ScrollViewer Name="PopularThisSeasonScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{Binding PopularThisSeason}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="20"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate DataType="models:AnimeCardData">
                                            <local:AnimeCard/>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            
                            <Button Classes="ghost round" Background="#00000000"
                                    Click="ScrollRight"
                                    CommandParameter="{Binding #PopularThisSeasonScroller}"
                                    Foreground="White"
                                    Width="30" Height="30"
                                    CornerRadius="25"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,-40,30"
                                    ZIndex="10"
                                    BorderThickness="0">
                                <Image Source="{SvgImage /Resources/Icons/chevronRight_icon.svg}" Width="30" Height="30" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="25" IsVisible="{Binding PopularUpcoming.Count}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="{Binding SecondSection, Source={x:Static misc:MediaMode.Instance}}"
                                      FontSize="26"
                                      FontWeight="Bold"
                                      Foreground="White"/>
                        </Grid>
                        
                        <Grid>
                            <Button Classes="ghost round" Background="#00000000"
                                    Click="ScrollLeft"
                                    CommandParameter="{Binding #PopularUpcomingScroller}"
                                    Foreground="White"
                                    Width="30" Height="30"
                                    CornerRadius="25"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-40,0,0,30"
                                    ZIndex="10"
                                    BorderThickness="0">
                                <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="30" Height="30" />
                            </Button>
                            
                            <ScrollViewer Name="PopularUpcomingScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{Binding PopularUpcoming}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="20"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate DataType="models:AnimeCardData">
                                            <local:AnimeCard/>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            
                            <Button Classes="ghost round" Background="#00000000"
                                    Click="ScrollRight"
                                    CommandParameter="{Binding #PopularUpcomingScroller}"
                                    Foreground="White"
                                    Width="30" Height="30"
                                    CornerRadius="25"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,-40,30"
                                    ZIndex="10"
                                    BorderThickness="0">
                                <Image Source="{SvgImage /Resources/Icons/chevronRight_icon.svg}" Width="30" Height="30" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="25" IsVisible="{Binding TrendingAllTime.Count}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="{Binding Noun, Source={x:Static misc:MediaMode.Instance}, StringFormat='{}Most Popular {0}'}"
                                      FontSize="26"
                                      FontWeight="Bold"
                                      Foreground="White"/>
                        </Grid>
                        
                        <Grid>
                            <Button Classes="ghost round" Background="#00000000"
                                    Click="ScrollLeft"
                                    CommandParameter="{Binding #TrendingAllTimeScroller}"
                                    Foreground="White"
                                    Width="30" Height="30"
                                    CornerRadius="25"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-40,0,0,30"
                                    ZIndex="10"
                                    BorderThickness="0">
                                <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="30" Height="30" />
                            </Button>
                            
                            <ScrollViewer Name="TrendingAllTimeScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{Binding TrendingAllTime}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="20"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate DataType="models:AnimeCardData">
                                            <local:AnimeCard/>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            
                            <Button Classes="ghost round" Background="#00000000" 
                                    Click="ScrollRight"
                                    CommandParameter="{Binding #TrendingAllTimeScroller}"
                                    Foreground="White"
                                    Width="30" Height="30"
                                    CornerRadius="25"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,-40,30"
                                    ZIndex="10"
                                    BorderThickness="0">
                                <Image Source="{SvgImage /Resources/Icons/chevronRight_icon.svg}" Width="30" Height="30" />
                            </Button>
                        </Grid>
                    </StackPanel>

                </StackPanel>

                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ViewMode, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Search}">
                    <Grid.Styles>
                        <Style Selector="Border.pager">
                            <Setter Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Padding" Value="4"/>
                        </Style>
                        <Style Selector="Border.pager TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Styles>

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,0,0,24">
                        <Button Grid.Column="0"
                                Classes="ghost"
                                Command="{Binding GoBackCommand}"
                                Padding="10,8"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="14" Height="14"/>
                                <TextBlock Text="Back" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="section-label" Text="SEARCH RESULTS"/>
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SearchQuery}"/>
                                <Run Text="{Binding TotalResults, StringFormat='· {0} titles'}" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" FontSize="16"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pager" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="ghost round" Width="30" Height="30" Command="{Binding PreviousPageCommand}">
                                    <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="14" Height="14"/>
                                </Button>
                                <TextBlock Text="{Binding CurrentPage}" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding TotalPages}" Foreground="{StaticResource TextSecondary}"/>
                                <Button Classes="ghost round" Width="30" Height="30" Command="{Binding NextPageCommand}">
                                    <Image Source="{SvgImage /Resources/Icons/chevronRight_icon.svg}" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SearchResults}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="22" LineSpacing="26"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:AnimeCardData">
                                <local:AnimeCard/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,60">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="TotalResults" Converter="{StaticResource EqualToZeroConverter}"/>
                                <Binding Path="!IsLoading"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <Image Source="/Resources/nothingtoseehere_transparent_small.png" Width="200" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="Nothing matched" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a shorter title or the Japanese name." FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="2" Classes="pager" HorizontalAlignment="Center" Margin="0,28,0,0"
                            IsVisible="{Binding TotalPages, Converter={StaticResource GreaterThanZeroConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost round" Width="30" Height="30" Command="{Binding PreviousPageCommand}">
                                <Image Source="{SvgImage /Resources/Icons/chevronLeft_icon.svg}" Width="14" Height="14"/>
                            </Button>
                            <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}" Foreground="White" FontWeight="SemiBold" Margin="6,0"/>
                            <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <Button Classes="ghost round" Width="30" Height="30" Command="{Binding NextPageCommand}">
                                <Image Source="{SvgImage /Resources/Icons/chevronRight_icon.svg}" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" 
                Grid.Row="0"
                Width="320"
                IsVisible="{Binding IsAnime, Source={x:Static misc:MediaMode.Instance}}"
                Background="{StaticResource BackgroundGray}" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1,0,0,0"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         AllowAutoHide="True"
                         Margin="0,20,0,0">
                <StackPanel Spacing="35">
                    
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchBox}"/>
                    
                    <StackPanel Spacing="15" IsVisible="{Binding IsAnime, Source={x:Static misc:MediaMode.Instance}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="Airing Today"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="White"/>
                        </Grid>
                        
                        <ItemsControl ItemsSource="{Binding AiringToday}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:AnimeCardData">
                                    <Border Background="{StaticResource Background0}" 
                                            CornerRadius="12" 
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Cursor="Hand"
                                            Tapped="OnDoubleTapped">
                                        <Grid ColumnDefinitions="60,*">
                                            <Border Grid.Column="0" 
                                                    Width="60" Height="85" 
                                                    CornerRadius="8" 
                                                    Background="{StaticResource Surface2}"
                                                    ClipToBounds="True">
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}" 
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" 
                                                       Margin="12,0,0,0" 
                                                       VerticalAlignment="Center"
                                                       Spacing="6">
                                                <TextBlock Text="{Binding Title}"
                                                          FontWeight="SemiBold"
                                                          Foreground="White"
                                                          FontSize="14"
                                                          TextTrimming="CharacterEllipsis"
                                                          MaxLines="2"
                                                          TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="★"
                                                              Foreground="{StaticResource RedColor}"
                                                              FontSize="12"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Score}"
                                                              Foreground="{StaticResource RedColor}"
                                                              FontSize="11"
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>